{
  "id": "openrouter",
  "name": "OpenRouter 余额",
  "providerKey": "openrouter",
  "urlTemplate": "https://openrouter.ai/api/v1/credits",
  "method": "GET",
  "headers": [
    { "key": "Authorization", "value": "Bearer {{apiKey}}" }
  ],
  "variables": ["apiKey"],
  "unit": "USD",
  "iconAsset": "openrouter.svg",
  "note": "OpenRouter 账户余额 (total - used)",
  "scriptSource": "{\"validWhen\":\"response.data != null\",\"remaining\":{\"expr\":\"response.data.total_credits - response.data.total_usage\"},\"used\":{\"path\":\"response.data.total_usage\"},\"total\":{\"path\":\"response.data.total_credits\"},\"unit\":\"USD\"}"
}
