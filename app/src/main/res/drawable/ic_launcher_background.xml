<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Base fill -->
    <path
        android:fillColor="#0F1722"
        android:pathData="M0,0h108v108h-108z" />

    <!-- Diagonal gradient highlight (top-left to bottom-right) -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:color="#FF1B2A40" android:offset="0.0" />
                <item android:color="#FF0F1722" android:offset="0.5" />
                <item android:color="#FF070B12" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle radial glow behind the gauge -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="58">
                <item android:color="#33FF6F00" android:offset="0.0" />
                <item android:color="#00FF6F00" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

</vector>
